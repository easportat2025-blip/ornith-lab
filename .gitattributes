# Normalize text files on checkout; keep Windows launchers native.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary
*.ckpt binary
*.gguf binary
*.onnx binary
*.npz binary
*.parquet binary
*.arrow binary
